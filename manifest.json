{
  "id": "org.meilox.qqmusic",
  "providerId": "qqmusic",
  "name": "QQ 音乐",
  "author": "MeiloX contributors",
  "version": "0.3.2",
  "apiVersion": 2,
  "entry": "index.js",
  "capabilities": [
    "catalog.search",
    "catalog.track",
    "lyrics.get",
    "playback.resolve",
    "feed.home",
    "feed.discover",
    "playlist.get",
    "playlist.tracks",
    "album.get",
    "album.tracks",
    "artist.get",
    "artist.tracks",
    "artist.albums",
    "account.get",
    "library.likedTracks",
    "library.createdPlaylists",
    "library.savedPlaylists",
    "library.savedAlbums",
    "library.followedArtists",
    "track.liked",
    "track.like",
    "collection.saved",
    "collection.save",
    "playlist.create",
    "playlist.update",
    "playlist.delete",
    "playlist.addTracks",
    "playlist.removeTracks",
    "feature.invoke"
  ],
  "permissions": {
    "network": [
      "*.qq.com",
      "*.gtimg.com",
      "*.gtimg.cn",
      "*.cdn-go.cn",
      "*.qpic.cn",
      "*.idqqimg.cn",
      "*.stream.qqmusic.qq.com"
    ],
    "storage": true,
    "effects": [
      "web.auth"
    ]
  },
  "config": [
    {
      "key": "cookie",
      "label": "本人 QQ 音乐网页 Cookie",
      "secret": true,
      "required": false
    },
    {
      "key": "uin",
      "label": "账号 ID（Cookie 中缺失时填写）",
      "secret": false,
      "required": false
    }
  ],
  "description": "支持 QQ 音乐首页、发现、歌曲/歌单/专辑/歌手搜索及详情。使用应用内网页登录访问本人账号、媒体库和收藏，也可手动填写本人 QQ 音乐网页 Cookie。账号 ID 通常留空。播放以 QQ 音乐当前账号授权为准。",
  "searchTypes": [
    "track",
    "playlist",
    "album",
    "artist"
  ],
  "collectionTypes": [
    "playlist",
    "album",
    "artist"
  ],
  "features": {
    "login": [
      "webLogin",
      "sessionState",
      "logout"
    ]
  },
  "featureRoutes": [
    "account/login"
  ],
  "sessionKeys": [
    "cookie",
    "manualCookieTag"
  ],
  "sessionCookieNames": {
    "cookie": [
      "uin",
      "p_uin",
      "wxuin",
      "wxopenid",
      "qqmusic_uin",
      "qqmusic_key",
      "qm_keyst",
      "p_skey",
      "skey",
      "p_lskey",
      "lskey",
      "login_type",
      "qqmusic_guid"
    ]
  },
  "concurrentReadFeatures": {
    "login": [
      "sessionState"
    ]
  }
}
